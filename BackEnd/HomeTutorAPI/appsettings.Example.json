{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hometutor_db;Username=YOUR_POSTGRES_USER;Password=YOUR_POSTGRES_PASSWORD"
  },
  "Jwt": {
    "SecretKey": "YOUR_MINIMUM_32_CHARACTER_RANDOM_SECRET_KEY_HERE",
    "Issuer": "HomeTutorAPI",
    "Audience": "HomeTutorClient",
    "AccessTokenMinutes": "60",
    "RefreshTokenDays": "30"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:3001"
  },
  "Razorpay": {
    "KeyId": "rzp_test_YOUR_KEY_ID",
    "KeySecret": "YOUR_RAZORPAY_SECRET",
    "WebhookSecret": "YOUR_RAZORPAY_WEBHOOK_SECRET"
  },
  "Email": {
    "SenderName": "HomeTutor",
    "SenderAddress": "noreply@hometutor.in",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUser": "YOUR_EMAIL@gmail.com",
    "SmtpPass": "YOUR_EMAIL_APP_PASSWORD"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
